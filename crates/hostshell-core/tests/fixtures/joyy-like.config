Host macpro
    HostName 192.168.3.6
    User engineer
    Port 22

Host jump
    HostName jump.example.test
    User engineer
    Port 32200

Host office
    HostName office.example.test
    User engineer
    IdentityFile /path/that/does/not/exist
    ProxyCommand cloudflared access ssh --hostname %h

Host 10.*
    User engineer
    Port 32200
    ProxyJump engineer@jump
